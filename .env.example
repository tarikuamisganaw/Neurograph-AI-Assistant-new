# ========================================
# Service Ports (Host Machine - Docker Compose Mapping)
# ========================================
ATOMSPACE_API_PORT=58000
ANNOTATION_SERVICE_PORT=58001
ANNOTATION_TOOL_PORT=53000
INTEGRATION_API_PORT=59000
NEO4J_HTTP_PORT=57474
NEO4J_BOLT_PORT=57687
HUGEGRAPH_PORT_EXTERNAL=58080
HUGEGRAPH_GREMLIN_PORT_EXTERNAL=58182
MORK_PORT=58231
MONGO_PORT=57017

# ========================================
# Service Internal Ports (Do not change unless you modify Dockerfiles)
# ========================================
API_PORT=58000   # Atomspace API internal port
APP_PORT=58001   # Annotation Service internal port

# ========================================
# Service URLs (For Annotation Tool Frontend)
# ========================================
# These are used by the browser to reach services. usage: http://localhost:<HOST_PORT>
LOADER_URL=http://localhost:58000       # Points to Atomspace API
ANNOTATION_URL=http://localhost:58001   # Points to Annotation Service
INTEGRATION_URL=http://localhost:59000  # Points to Integration Service

# ========================================
# Integration Service Configuration
# ========================================
# Internal Docker Network URLs
ATOMSPACE_API_URL=http://atomspace-api:58000
NEURAL_MINER_URL=http://neural-miner:59002
ANNOTATION_SERVICE_URL=http://annotation_service:58001


# Timeouts
ATOMSPACE_TIMEOUT=600
MINER_TIMEOUT=1800
ANNOTATION_TIMEOUT=300
CSV_CACHE_DIR=./cache
SHARED_VOLUME_PATH=/shared/output

# ========================================
# LLM Configuration (For Annotation Service)
# ========================================
LLM_PROVIDER=gemini # 'openai' or 'gemini'
LLM_MODEL=gemini
GEMINI_API_KEY=
LLM_API_KEY=

# ========================================
# Neo4j Database
# ========================================
NEO4J_HOST=neo4j
NEO4J_PORT=57687
NEO4J_HTTP_PORT=57474
NEO4J_BOLT_PORT=57687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G

# ========================================
# HugeGraph Configuration
# ========================================
HUGEGRAPH_HOST=hugegraph
HUGEGRAPH_PORT=58080
HUGEGRAPH_GRAPH=hugegraph
HUGEGRAPH_REST_PORT=58080
HUGEGRAPH_GREMLIN_PORT=58182
MORK_URL=http://mork:8231